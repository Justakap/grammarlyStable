# Port the backend listens on
PORT=8787

# Origin allowed to call this backend (your deployed frontend URL in production)
FRONTEND_ORIGIN=http://localhost:5173

# Shared secret the Colab runtime must present to register its URL.
# Generate a long random value and keep it secret.
BACKEND_REGISTRATION_TOKEN=change-me-to-a-long-random-secret

# Optional: seed the active Colab endpoint on startup (normally set via /api/colab/register instead)
COLAB_API_URL=

# Optional: how long to wait for the Colab model before timing out (ms)
COLAB_REQUEST_TIMEOUT_MS=25000

# Optional: must match the API_KEY set in the Colab script, if any.
# Sent as the x-api-key header on every forwarded /correct request.
COLAB_API_KEY=
